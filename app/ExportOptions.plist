<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  How `./dt ship` hands the archive to Apple.

  `destination: upload` sends it straight to App Store Connect rather than writing an
  .ipa to disk for a second tool to pick up. The version and build number are the
  archive's own — package.json and the commit count, see project.yml — and Apple is
  not asked to manage either: its option only renumbers within one version, and a
  number it has seen under another version still fails processing. The team id is not
  here: `dt` copies this file and inserts it from app/.team, the same place the device
  build reads it, so it is written down once.
-->
<plist version="1.0">
<dict>
  <key>method</key>
  <string>app-store-connect</string>
  <key>destination</key>
  <string>upload</string>
  <key>signingStyle</key>
  <string>automatic</string>
  <key>uploadSymbols</key>
  <true/>
</dict>
</plist>
