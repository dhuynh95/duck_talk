#!/bin/bash
# Build/run/inspect the iOS app from the CLI. Everything an agent needs to close
# the loop without opening Xcode: xcodegen + xcodebuild + simctl, nothing else.
#
#   ./dt build            regenerate project, build for the simulator
#   ./dt run              build, boot sim, install, launch (relaunches if running)
#   ./dt shot [file]      screenshot the booted sim (default: .build/shot.png)
#   ./dt logs [seconds]   app's stdout/stderr + os_log for N seconds (default 10)
#   ./dt udid             UDID of the target simulator, booting it if needed
#   ./dt phone            build for the iPhone on the cable, install, launch
#   ./dt ship             archive signed for distribution and upload to TestFlight
#   ./dt mcp              serve the ios-sim MCP over HTTP, reloading on every edit
#   ./dt clean            drop derived data
#
# Override the simulator with SIM=... (name or UDID).
#
# A device build must be signed, and signing needs an Apple team: put its ID in
# app/.team (gitignored) or DEVELOPMENT_TEAM. Xcode ▸ Settings ▸ Accounts shows it
# once an Apple ID is signed in; a free personal team is enough for a cabled phone.

set -euo pipefail
cd "$(dirname "$0")"

SCHEME=DuckTalk
PROJECT=DuckTalk.xcodeproj
BUNDLE_ID=dev.conception.duck-talk
SIM="${SIM:-iPhone 17 Pro}"
DERIVED=.build

require_xcode() {
  if ! xcodebuild -version >/dev/null 2>&1; then
    echo "error: full Xcode is required (found only Command Line Tools)." >&2
    echo "  Install Xcode, then: sudo xcode-select -s /Applications/Xcode.app" >&2
    exit 1
  fi
}

# Only the lines worth reading: errors, warnings, and the final status.
filter() {
  grep -E '(error|warning|note):|^\*\* .* \*\*|Testing failed|failed with' || true
}

# Regenerate the project — and, beside it, what an editor needs to read it. Without
# buildServer.json SourceKit compiles each file alone, for the Mac, and every iOS type
# and every symbol from another file shows as an error; with it, the editor and
# `./dt build` see the same project from the same derived data. Absolute paths, so it
# is written here rather than committed. Skipped without `brew install xcode-build-server`.
gen() {
  # The app's version is the relay's: one package.json, read here and by the relay at
  # startup, so a phone and a relay from one release carry one number. The build
  # number is the commit count — monotonic, and it names the commit. xcodegen
  # substitutes both into project.yml.
  DUCK_TALK_VERSION=$(node -p "require('../package.json').version") \
  DUCK_TALK_BUILD=$(git rev-list --count HEAD) \
    xcodegen generate --quiet
  local bsp
  bsp=$(command -v xcode-build-server) || return 0
  cat > buildServer.json <<JSON
{
  "name": "xcode build server",
  "version": "1.3.0",
  "bspVersion": "2.2.0",
  "languages": ["c", "cpp", "objective-c", "objective-cpp", "swift"],
  "argv": ["$bsp"],
  "workspace": "$PWD/$PROJECT/project.xcworkspace",
  "build_root": "$PWD/$DERIVED",
  "scheme": "$SCHEME",
  "kind": "xcode"
}
JSON
}

build() {
  require_xcode
  gen
  set -o pipefail
  xcodebuild -project "$PROJECT" -scheme "$SCHEME" \
    -destination "platform=iOS Simulator,name=$SIM" \
    -derivedDataPath "$DERIVED" \
    -quiet build 2>&1 | filter
}

# UDID of the target simulator, booting it if needed.
boot() {
  local udid
  udid=$(xcrun simctl list devices available -j \
    | python3 -c "
import json,sys
want=sys.argv[1].lower()
data=json.load(sys.stdin)['devices']
for runtime in sorted(data, reverse=True):
    for d in data[runtime]:
        if want in (d['name'].lower(), d['udid'].lower()):
            print(d['udid']); sys.exit(0)
sys.exit('no available simulator matching %r' % sys.argv[1])
" "$SIM")
  xcrun simctl bootstatus "$udid" -b >/dev/null 2>&1 || xcrun simctl boot "$udid"
  open -ga Simulator
  echo "$udid"
}

# The model-facing surface, served over HTTP so an edit to sim.py is live on the next
# tool call. .mcp.json points at this URL; nothing spawns it, so it must be running.
mcp() {
  exec .venv/bin/uvicorn sim:app \
    --host "${SIM_HOST:-127.0.0.1}" --port "${SIM_PORT:-8766}" \
    --reload --reload-exclude '.venv/*' --reload-exclude '.build/*'
}

app_path() {
  echo "$DERIVED/Build/Products/Debug-iphonesimulator/$SCHEME.app"
}

run() {
  build
  local udid
  udid=$(boot)
  xcrun simctl terminate "$udid" "$BUNDLE_ID" >/dev/null 2>&1 || true
  xcrun simctl install "$udid" "$(app_path)"
  # Granting a permission terminates the app if it is running, so grant before launch.
  xcrun simctl privacy "$udid" grant microphone "$BUNDLE_ID"
  xcrun simctl launch "$udid" "$BUNDLE_ID"
}

# --- Physical iPhone, over the cable ----------------------------------------
# The simulator path above signs nothing and installs with simctl; a device needs
# a signed build and devicectl. Same derived data, a different Products folder.

team() {
  local team="${DEVELOPMENT_TEAM:-}"
  [ -n "$team" ] || [ ! -f .team ] || team=$(tr -d '[:space:]' < .team)
  if [ -z "$team" ]; then
    echo "error: no signing team. Sign in to an Apple ID in Xcode ▸ Settings ▸ Accounts," >&2
    echo "  then write the team ID (10 characters, shown there) to app/.team." >&2
    exit 1
  fi
  echo "$team"
}

# The one iPhone that is paired and reachable, as its two names: devicectl works
# by coredevice identifier, xcodebuild by hardware UDID. Anything else on the list
# — unpaired, or a phone that was here yesterday — is reported, not picked.
phone_id() {
  local json="$DERIVED/devices.json"
  mkdir -p "$DERIVED"
  xcrun devicectl list devices --json-output "$json" >/dev/null 2>&1
  python3 -c "
import json,sys
devs=json.load(open(sys.argv[1]))['result']['devices']
ok=[d for d in devs if d['connectionProperties'].get('pairingState')=='paired'
    and d['connectionProperties'].get('tunnelState')!='unavailable']
if len(ok)==1: print(ok[0]['identifier'], ok[0]['hardwareProperties']['udid']); sys.exit(0)
for d in devs:
    c=d['connectionProperties']
    print('  %s: %s, tunnel %s' % (d['deviceProperties'].get('name'), c.get('pairingState'), c.get('tunnelState')), file=sys.stderr)
sys.exit('no single paired iPhone on the cable (unlock it and tap Trust; turn on Settings > Privacy & Security > Developer Mode)')
" "$json"
}

phone() {
  require_xcode
  gen
  local team udid hw
  team=$(team)
  read -r udid hw < <(phone_id)
  set -o pipefail
  # -allowProvisioningUpdates lets xcodebuild register the phone and mint the
  # profile itself, which is otherwise a trip through Xcode's signing pane. It can
  # only enrol a device it was aimed at, so this builds for *this* phone by UDID —
  # "generic/platform=iOS" signs for a team that may have no devices at all.
  xcodebuild -project "$PROJECT" -scheme "$SCHEME" \
    -destination "id=$hw" \
    -derivedDataPath "$DERIVED" \
    -allowProvisioningUpdates \
    DEVELOPMENT_TEAM="$team" \
    -quiet build 2>&1 | filter
  xcrun devicectl device install app --device "$udid" \
    "$DERIVED/Build/Products/Debug-iphoneos/$SCHEME.app"
  xcrun devicectl device process launch --terminate-existing --device "$udid" "$BUNDLE_ID"
  # The address to paste under gear ▸ Server is on the relay's own startup lines —
  # it is the one process that knows every way it can be reached.
}

# --- App Store Connect ------------------------------------------------------
# The release build, signed for distribution and handed to TestFlight. Everything
# a device build needed plus one thing: proof to Apple of who is uploading. Two ways
# to give it, and xcodebuild takes either — an App Store Connect API key in
# app/.asc/ (gitignored: AuthKey_<ID>.p8 beside an `issuer` file holding the issuer
# id), which is headless and works in CI; or the Apple ID signed into Xcode ▸
# Settings ▸ Accounts, which works only on a Mac someone has sat at. The key comes
# from App Store Connect ▸ Users and Access ▸ Integrations ▸ Team Keys, role
# App Manager, and downloads exactly once.
#
# The certificate and the profile are minted by Apple on the way through
# (-allowProvisioningUpdates), so a fresh Mac needs nothing in its keychain first —
# the key has to be an Admin one, though: an App Manager key may upload but may not
# mint the distribution certificate ("Cloud signing permission error", measured).
# The build number is the commit count (see `gen`), so nothing here is bumped by
# hand and two uploads never collide unless they are the same commit.
#
# The archive itself is unsigned. Archiving with automatic signing wants a
# *development* profile, and a team with no registered device cannot have one; the
# export step is what signs for distribution anyway, so signing at archive time
# bought nothing but that failure.

asc_auth() {
  local key
  key=$(ls .asc/AuthKey_*.p8 2>/dev/null | head -1) || true
  [ -n "$key" ] || return 0 # no key: xcodebuild falls back to the account in Xcode
  local id=${key#.asc/AuthKey_}; id=${id%.p8}
  [ -f .asc/issuer ] || { echo "error: .asc/issuer is missing — the issuer id shown above the key list" >&2; exit 1; }
  echo "-authenticationKeyPath $PWD/$key -authenticationKeyID $id -authenticationKeyIssuerID $(tr -d '[:space:]' < .asc/issuer)"
}

ship() {
  require_xcode
  gen
  local team auth archive="$DERIVED/$SCHEME.xcarchive"
  team=$(team)
  auth=$(asc_auth)
  set -o pipefail
  rm -rf "$archive"
  # shellcheck disable=SC2086  # $auth is a flag list, and empty is a valid one
  xcodebuild -project "$PROJECT" -scheme "$SCHEME" \
    -destination 'generic/platform=iOS' \
    -derivedDataPath "$DERIVED" \
    -archivePath "$archive" \
    CODE_SIGNING_ALLOWED=NO \
    -quiet archive 2>&1 | filter
  # The team rides in from .team rather than being written into the plist twice; an
  # unsigned archive carries none of its own, and export refuses without one.
  local options="$DERIVED/ExportOptions.plist"
  cp ExportOptions.plist "$options"
  plutil -insert teamID -string "$team" "$options"
  # shellcheck disable=SC2086
  xcodebuild -exportArchive \
    -archivePath "$archive" \
    -exportOptionsPlist "$options" \
    -exportPath "$DERIVED/export" \
    -allowProvisioningUpdates $auth 2>&1 | grep -vE '^\s*$|IDEDistributionLogging' | tail -20
  echo "uploaded — processing takes a few minutes, then it appears under TestFlight ▸ Builds"
}

shot() {
  local out="${1:-$DERIVED/shot.png}"
  mkdir -p "$(dirname "$out")"
  xcrun simctl io booted screenshot --type=png "$out"
  echo "$out"
}

logs() {
  local secs="${1:-10}"
  # simctl spawn log stream needs a subsystem filter or it drowns in system noise.
  timeout "$secs" xcrun simctl spawn booted log stream \
    --level debug --style compact \
    --predicate "subsystem CONTAINS \"$BUNDLE_ID\" OR processImagePath CONTAINS \"$SCHEME\"" \
    2>/dev/null || true
}

case "${1:-run}" in
  gen)   gen ;;
  build) build ;;
  run)   run ;;
  shot)  shot "${2:-}" ;;
  logs)  logs "${2:-10}" ;;
  udid)  boot ;;
  phone) phone ;;
  ship)  ship ;;
  mcp)   mcp ;;
  clean) rm -rf "$DERIVED" && echo "cleaned $DERIVED" ;;
  *)     sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//' >&2 ; exit 1 ;;
esac
