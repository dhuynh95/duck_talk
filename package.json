{
  "name": "duck_talk",
  "version": "0.2.1",
  "type": "module",
  "description": "Talk to Claude Code from your phone: a voice relay you run in the folder you want it to work on",
  "keywords": [
    "claude",
    "claude-code",
    "voice",
    "speech-to-text",
    "text-to-speech",
    "gemini",
    "agent"
  ],
  "license": "MIT",
  "author": "Daniel Huynh",
  "homepage": "https://github.com/dhuynh95/duck_talk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhuynh95/duck_talk.git"
  },
  "bugs": {
    "url": "https://github.com/dhuynh95/duck_talk/issues"
  },
  "bin": {
    "duck-talk": "dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node --watch server/cli.ts",
    "check": "tsc --noEmit",
    "build": "tsc && node -e \"require('fs').cpSync('server/prompts','dist/prompts',{recursive:true})\"",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.259",
    "@google/genai": "^2.19.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.1",
    "typescript": "~5.9.3"
  }
}
